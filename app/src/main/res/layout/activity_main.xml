<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_vertical"
    android:background="#F8F9FA"> <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Évaluation Fiscale"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="#2C3E50"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/champSuperficie"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:hint="Surface totale (m²)"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/champChambres"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:hint="Nombre de pièces"
        android:inputType="number"
        android:padding="16dp"
        android:layout_marginBottom="20dp" />

    <CheckBox
        android:id="@+id/casePiscine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Le bien possède-t-il une piscine ?"
        android:textSize="16sp"
        android:padding="8dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/button_calcul"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="CALCULER L'IMPÔT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2980B9"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/affichageTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F8F5"
        android:elevation="2dp"
        android:padding="20dp"
        android:text="Résultat : -- DH"
        android:textAlignment="center"
        android:textColor="#16A085"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
